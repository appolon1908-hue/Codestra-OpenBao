{
  "schemaVersion": 1,
  "status": "PREPARED_DISABLED",
  "runtimeApplyAuthorized": false,
  "issuer": "https://auth.codestra.co/realms/codestra",
  "authMethod": "jwt",
  "audience": "openbao",
  "requiredClaims": ["iss", "sub", "aud", "azp", "iat", "exp", "jti"],
  "maximumTokenLifetimeSeconds": 300,
  "defaultPolicy": "deny",
  "secretInjection": {
    "method": "agent-rendered-file",
    "environmentVariablesAllowed": false,
    "containerImageBakeAllowed": false,
    "gitMaterializationAllowed": false,
    "fileMode": "0400",
    "renewableLeasesRequired": true
  },
  "rotation": {
    "ownerRequired": true,
    "maximumAgeDays": 90,
    "overlapRequired": true,
    "revocationTestRequired": true,
    "auditEventRequired": true
  },
  "roles": [
    {
      "environment": "production",
      "serviceIdentity": "kong-gateway",
      "boundClaims": {"azp": "kong-gateway", "codestra_environment": "production"},
      "pathPrefixes": ["codestra/production/kong/"],
      "operations": ["read"]
    },
    {
      "environment": "production",
      "serviceIdentity": "middleware-api",
      "boundClaims": {"azp": "middleware-api", "codestra_environment": "production"},
      "pathPrefixes": ["codestra/production/middleware/api/"],
      "operations": ["read"]
    },
    {
      "environment": "production",
      "serviceIdentity": "middleware-worker",
      "boundClaims": {"azp": "middleware-worker", "codestra_environment": "production"},
      "pathPrefixes": ["codestra/production/middleware/worker/"],
      "operations": ["read"]
    },
    {
      "environment": "production",
      "serviceIdentity": "n8n-automation",
      "boundClaims": {"azp": "n8n-automation", "codestra_environment": "production"},
      "pathPrefixes": ["codestra/production/n8n/middleware-client/"],
      "operations": ["read"]
    },
    {
      "environment": "production",
      "serviceIdentity": "odoo-integration",
      "boundClaims": {"azp": "odoo-integration", "codestra_environment": "production"},
      "pathPrefixes": ["codestra/production/odoo/integration/"],
      "operations": ["read"]
    },
    {
      "environment": "staging",
      "serviceIdentity": "kong-gateway",
      "boundClaims": {"azp": "kong-gateway", "codestra_environment": "staging"},
      "pathPrefixes": ["codestra/staging/kong/"],
      "operations": ["read"]
    },
    {
      "environment": "staging",
      "serviceIdentity": "middleware-api",
      "boundClaims": {"azp": "middleware-api", "codestra_environment": "staging"},
      "pathPrefixes": ["codestra/staging/middleware/api/"],
      "operations": ["read"]
    },
    {
      "environment": "staging",
      "serviceIdentity": "middleware-worker",
      "boundClaims": {"azp": "middleware-worker", "codestra_environment": "staging"},
      "pathPrefixes": ["codestra/staging/middleware/worker/"],
      "operations": ["read"]
    },
    {
      "environment": "staging",
      "serviceIdentity": "n8n-automation",
      "boundClaims": {"azp": "n8n-automation", "codestra_environment": "staging"},
      "pathPrefixes": ["codestra/staging/n8n/middleware-client/"],
      "operations": ["read"]
    },
    {
      "environment": "staging",
      "serviceIdentity": "odoo-integration",
      "boundClaims": {"azp": "odoo-integration", "codestra_environment": "staging"},
      "pathPrefixes": ["codestra/staging/odoo/integration/"],
      "operations": ["read"]
    }
  ],
  "explicitDeny": {
    "n8n-automation": [
      "codestra/production/beyvra/",
      "codestra/production/klyrow/",
      "codestra/production/telnexa/",
      "codestra/production/vicidial/"
    ],
    "observability": ["codestra/production/"]
  },
  "requiredEvidence": [
    "audit_event",
    "lease_id_hash",
    "policy_name",
    "role_name",
    "sanitized_path_prefix",
    "service_identity"
  ]
}
